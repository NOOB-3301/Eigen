{
  "defaultModel": "local",
  "models": {
    "local": {
      "id": "ollama/gemma4:e4b",
      "url": "http://localhost:11434/v1",
      "contextWindow": 28000,
      "replyReserve": 4096
    },
    "cloud": {
      "id": "anthropic/claude-sonnet-5-5"
    }
  },
  "curatorModel": "cloud",
  "telegram": {
    "tokenEnv": "TELEGRAM_BOT_TOKEN",
    "allowedUserIds": []
  },
  "limits": { "maxSteps": 25 },
  "sandbox": {
    "isolation": "auto",
    "allowNetwork": true,
    "readWritePaths": [],
    "readOnlyPaths": [],
    "commandTimeoutMs": 120000
  },
  "memory": {
    "lastMessages": 20,
    "semanticRecall": { "enabled": true, "topK": 4, "messageRange": 2 },
    "embedder": { "id": "ollama/nomic-embed-text", "url": "http://localhost:11434/v1" },
    "consolidationCron": "30 3 * * *"
  },
  "mcpServers": {},
  "mcp": { "enabled": true, "startupTimeoutMs": 20000 }
}
