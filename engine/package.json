{
  "name": "@eigen/engine",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A personal agent you talk to over Telegram, built on Mastra.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "migrate": "node scripts/migrate.ts",
    "dev": "mastra dev --env ${EIGEN_HOME:-$HOME/.eigen}/.env",
    "build": "mastra build --studio",
    "serve": "mastra start --env ${EIGEN_HOME:-$HOME/.eigen}/.env",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "mastra build --studio && vitest run --config vitest.e2e.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "service": "node scripts/service.ts"
  },
  "dependencies": {
    "@chat-adapter/telegram": "4.41.1",
    "@mastra/ai-sdk": "1.10.6",
    "@mastra/core": "1.73.0",
    "@mastra/libsql": "1.24.1",
    "@mastra/loggers": "1.3.4",
    "@mastra/mcp": "2.1.2",
    "@mastra/memory": "1.34.0",
    "ai": "7.0.127",
    "croner": "^10.0.1",
    "dayjs": "^1.11.23",
    "lodash-es": "^4.18.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.4",
    "mastra": "1.32.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  },
  "exports": {
    "./schema": "./src/mastra/lib/schema.ts",
    "./home": "./src/mastra/lib/home.ts",
    "./store": "./src/mastra/lib/store.ts",
    "./config": "./src/mastra/lib/config.ts",
    "./envfile": "./src/mastra/lib/envfile.ts",
    "./skillspec": "./src/mastra/lib/skillspec.ts"
  }
}
